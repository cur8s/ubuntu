#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
export UBUNTU_BOOTSTRAP_ROOT="$ROOT_DIR"

# shellcheck source=../lib/common.sh
source "$ROOT_DIR/lib/common.sh"
# shellcheck source=../lib/checks.sh
source "$ROOT_DIR/lib/checks.sh"

usage() {
  cat <<'USAGE'
Usage: sudo ./bin/ubuntu-check

Verifies the opinionated Ubuntu baseline.

Options:
  -h, --help  Show this help.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      die "unexpected argument: $1"
      ;;
  esac
done

configure_baseline

require_root
require_ubuntu
run_enabled_modules_step verify
finish_checks
