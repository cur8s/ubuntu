#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
export UBUNTU_BOOTSTRAP_ROOT="$ROOT_DIR"

# shellcheck source=../lib/common.sh
source "$ROOT_DIR/lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: sudo ./bin/ubuntu-bootstrap

Applies the opinionated Ubuntu baseline to a fresh host.

Options:
  -h, --help  Show this help.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      die "unexpected argument: $1"
      ;;
  esac
done

configure_baseline

export UBUNTU_APT_UPDATE_STAMP="${UBUNTU_APT_UPDATE_STAMP:-/tmp/ubuntu-bootstrap-apt-updated.$$}"

log "using opinionated baseline"
log "enabled modules: ${UBUNTU_BOOTSTRAP_MODULES:-none}"

for phase in $UBUNTU_BOOTSTRAP_PHASES; do
  run_phase "$phase"
done

log "bootstrap complete"
