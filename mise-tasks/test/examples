#!/usr/bin/env bash
#MISE description="Every example twice; the second pass must report changed=0"
set -euo pipefail
. "$MISE_CONFIG_ROOT/mise-tasks/test/example-suite.sh"

# Test every example; single caller, so the function lives here (lib.sh
# admission rule). Coverage comes from globbing examples/ — a missing
# per-example task wrapper can never silently drop an example from the
# suite; it only earns a warning.
test_all_examples() {
  local target="$1" example_dir name tested=0

  for example_dir in "$MISE_CONFIG_ROOT/examples"/*/; do
    name="$(basename "$example_dir")"
    [[ -f $example_dir/site.yml ]] || continue

    # The per-example wrappers live at mise-tasks/test/example-<name>.
    if [[ $target == qemu && ! -x "$MISE_CONFIG_ROOT/mise-tasks/test/example-$name" ]]; then
      echo "WARN examples/$name has no mise-tasks/test/example-$name wrapper (still tested by this suite)." >&2
    fi

    test_example "$name" "$target"
    tested=$((tested + 1))
  done

  # The glob IS the coverage claim: zero examples found must refuse,
  # not print success over an empty directory.
  if [ "$tested" -eq 0 ]; then
    echo "FAIL: no examples with a site.yml found under examples/." >&2
    exit 1
  fi
  echo "All $tested examples passed twice on $target."
}

test_all_examples qemu
