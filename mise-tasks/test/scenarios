#!/usr/bin/env bash
#MISE description="Both adoption rehearsals, one VM at a time: root-user, then sudo-user (adopt -> converge x2 -> validate-reboot -> lock -> two doors)"
set -euo pipefail
. "$MISE_CONFIG_ROOT/mise-tasks/lib.sh"
prepare_ansible_temp

log_dir="$MISE_CONFIG_ROOT/.generated/scenarios"
mkdir -p "$log_dir"

run_scenario() {
  local scenario="$1" door_user="$2"

  echo
  echo "=== scenario: $scenario (door on: $door_user) ==="
  if [ -d "$QVM_DIR" ]; then
    MISE_YES=1 mise run vm:destroy
  fi
  mise run "vm:build-$scenario-scenario"
  mise run vm:start

  ADOPT_USER="$door_user" mise run host:adoptable
  ADOPT_USER="$door_user" mise run host:adopt

  echo "--- converge #1 (the delta the verdict predicted)"
  mise run host:converge

  echo "--- converge #2 (the contract: changed=0)"
  local log="$log_dir/$scenario-converge2.log"
  if ! mise run host:converge > "$log" 2>&1; then
    cat "$log"
    echo "FAIL scenario $scenario: second converge failed." >&2
    exit 1
  fi
  assert_changed_zero "$log" "scenario $scenario"

  echo "--- acceptance gate: validate-reboot"
  mise run host:validate-reboot

  echo "--- lock the scenario door ($door_user)"
  LOCK_ACCOUNTS="$door_user" MISE_YES=1 mise run host:lock-accounts

  echo "--- report: assert exactly the two baseline doors"
  local report="$log_dir/$scenario-report.log"
  if ! mise run host:report-access > "$report" 2>&1; then
    cat "$report"
    exit 1
  fi
  assert_two_doors "$report"

  MISE_YES=1 mise run vm:destroy
  echo "=== scenario $scenario: PASSED"
}

run_scenario root-user root
run_scenario sudo-user "${SCENARIO_USER:-ubuntu}"

echo
echo "test:scenarios PASSED - both rehearsals: adopt, changed=0, reboot survived, two doors."
