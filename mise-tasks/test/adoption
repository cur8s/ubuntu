#!/usr/bin/env bash
#MISE description="Both adoption rehearsals end to end: verdict asserted -> adopt -> converge x2 (changed=0) -> reboot-and-verify -> lock -> exactly two doors remain"
set -euo pipefail
. "$MISE_CONFIG_ROOT/collection/scripts/activate-test-credentials.sh"
. "$MISE_CONFIG_ROOT/mise-tasks/test/suite-asserts.sh"
activate_test_credentials

log_dir="$MISE_CONFIG_ROOT/.generated/adoption"
mkdir -p "$log_dir"
rm -f "$log_dir"/*

run_rehearsal() {
  local shape="$1" door_user="$2"

  echo
  echo "=== rehearsal: $shape (door on: $door_user) ==="
  if [ -d "$QVM_DIR" ]; then
    MISE_YES=1 mise run vm:destroy
  fi
  mise run vm:build-adoptable "$shape"
  mise run vm:start
  # Gate on cloud-init DONE, not just "sshd answers": the sudo shape's
  # ssh_pwauth lands in a later cloud-init stage than the door key, and
  # an early sshd -T probe would honestly miss [PASSWORD_AUTH_ENABLED].
  bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" wait-until-ready "$door_user" "$BOOTSTRAP_PUB_KEY"

  # The verdict must pass AND carry the right codes: the first-converge
  # delta always, the password-auth warning only where pwauth is on
  # (RFC-007 verdict codes; the refusal side lives in
  # test:adoption-refusals).
  local alog="$log_dir/$shape-adoptable.log"
  if ! ADOPT_USER="$door_user" mise run host:adoptable > "$alog" 2>&1; then
    cat "$alog"
    echo "FAIL rehearsal $shape: adoptable refused a clean rehearsal server." >&2
    exit 1
  fi
  grep -qF '[FIRST_CONVERGE_DELTA]' "$alog" || {
    cat "$alog"
    echo "FAIL rehearsal $shape: verdict missing [FIRST_CONVERGE_DELTA]." >&2
    exit 1
  }
  if [ "$shape" = sudo-user ]; then
    grep -qF '[PASSWORD_AUTH_ENABLED]' "$alog" || {
      cat "$alog"
      echo "FAIL rehearsal sudo-user: verdict missing [PASSWORD_AUTH_ENABLED]." >&2
      exit 1
    }
  elif grep -qF '[PASSWORD_AUTH_ENABLED]' "$alog"; then
    cat "$alog"
    echo "FAIL rehearsal root-user: [PASSWORD_AUTH_ENABLED] fired with pwauth off." >&2
    exit 1
  fi
  # Clean rehearsal servers must not trip the never-fires-here warnings.
  for absent_code in COMPETING_SSHD_DROPINS PENDING_REBOOT; do
    if grep -qF "[$absent_code]" "$alog"; then
      cat "$alog"
      echo "FAIL rehearsal $shape: [$absent_code] fired on a clean rehearsal server." >&2
      exit 1
    fi
  done
  ADOPT_USER="$door_user" mise run host:adopt

  echo "--- converge #1 (the delta the verdict predicted)"
  mise run host:converge

  echo "--- converge #2 (the contract: changed=0)"
  local log="$log_dir/$shape-converge2.log"
  if ! mise run host:converge > "$log" 2>&1; then
    cat "$log"
    echo "FAIL rehearsal $shape: second converge failed." >&2
    exit 1
  fi
  assert_changed_zero "$log" "rehearsal $shape"

  echo "--- acceptance gate: reboot-and-verify"
  mise run host:reboot-and-verify

  echo "--- lock the rehearsal door ($door_user)"
  LOCK_ACCOUNTS="$door_user" MISE_YES=1 mise run host:lock-accounts

  echo "--- report: assert exactly the two baseline doors"
  local report="$log_dir/$shape-report.log"
  if ! mise run host:report-access > "$report" 2>&1; then
    cat "$report"
    echo "FAIL rehearsal $shape: report-access failed." >&2
    exit 1
  fi
  assert_two_doors "$report" "rehearsal $shape"

  MISE_YES=1 mise run vm:destroy
  echo "=== rehearsal $shape: PASSED"
}

run_rehearsal root-user root
run_rehearsal sudo-user "${DOOR_USER:-ubuntu}"

echo
echo "test:adoption PASSED - both rehearsals: adopt, changed=0, reboot survived, two doors."
