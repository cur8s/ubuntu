#!/usr/bin/env bash
#MISE description="Install a new public key for ansible or sysadmin, delivered via its sibling account"
set -euo pipefail
. "$MISE_CONFIG_ROOT/collection/scripts/run-lab-playbook.sh"

: "${ROTATE_ACCOUNT:?set ROTATE_ACCOUNT=ansible|sysadmin}"
: "${ROTATE_NEW_PUB_KEY:?set ROTATE_NEW_PUB_KEY=/path/to/new.pub}"
run_lab_playbook "$MISE_CONFIG_ROOT/collection/playbooks/rotate_key.yml" "$@"
