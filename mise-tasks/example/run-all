#!/usr/bin/env sh
#MISE description="Run every example twice against a lab VM; the second pass must report changed=0"
#MISE depends=["example:link"]
#USAGE arg "[target]" help="Lab to run against: droplet (default) or qemu" default="droplet"
set -eu
. "$MISE_CONFIG_ROOT/mise-tasks/lib.sh"
ssh_task_preamble

target="${usage_target:-droplet}"
skipped=""

for example_dir in "$MISE_CONFIG_ROOT/examples"/*/; do
  name="$(basename "$example_dir")"
  [ -f "$example_dir/site.yml" ] || continue

  if [ "$name" = "tailscale" ] && [ -z "${TAILSCALE_AUTHKEY:-}" ]; then
    echo "SKIP tailscale: TAILSCALE_AUTHKEY is not set. (Joining also leaves a node"
    echo "in the tailnet admin console unless the auth key is ephemeral.)"
    skipped="$skipped tailscale"
    continue
  fi

  echo "==> $name ($target): first run"
  example_run "$name" "$target"

  # The examples' contract: a second run is a full no-op. Output goes to a
  # log so a clean pass stays quiet; recap lines are the only place ansible
  # prints "changed=N", so grepping the log for a non-zero count is exact.
  echo "==> $name ($target): second run (idempotency contract: changed=0)"
  second_log="$ANSIBLE_LOCAL_TEMP/example-run-all-$name.log"
  if ! example_run "$name" "$target" > "$second_log" 2>&1; then
    cat "$second_log"
    echo "FAIL $name: second run failed." >&2
    exit 1
  fi
  if grep -qE 'changed=[1-9]' "$second_log"; then
    grep -A9 "PLAY RECAP" "$second_log" || cat "$second_log"
    echo "FAIL $name: second run reported changes." >&2
    exit 1
  fi
  grep -hA3 "PLAY RECAP" "$second_log" | sed "s/^/    /"
done

echo "All examples passed twice on $target.${skipped:+ Skipped:$skipped.}"
