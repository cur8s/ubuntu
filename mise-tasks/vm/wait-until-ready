#!/usr/bin/env bash
#MISE description="Block until the VM is ready, riding out the first-boot upgrade and reboot (next: host:converge)"
set -euo pipefail
. "$MISE_CONFIG_ROOT/collection/scripts/activate-test-credentials.sh"
activate_test_credentials
echo "Waiting for cloud-init to finish (a first boot may upgrade and reboot)..."
# The lab's private keys sit beside their .pub files, so the harness can
# probe with the file directly — no agent involved.
bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" \
  wait-until-ready ansible "$QEMU_KEYS_DIR/ubuntu-ansible"
echo "cloud-init is done; the VM is ready."
