#!/usr/bin/env bash
#MISE description="Stages done so far, and the next command"
#MISE quiet=true
set -euo pipefail
. "$MISE_CONFIG_ROOT/mise-tasks/qvm.sh"
next=""

# One qvm status call answers both rows; its vocabulary is contract
# (cur8s/qemu RFC-001): image cached|missing, vm running|stopped|absent.
harness="$(qvm status)"

if [[ -s "$QEMU_KEYS_DIR/ubuntu-ansible.pub" && -s "$QEMU_KEYS_DIR/ubuntu-sysadmin.pub" ]] \
  && grep -q '^image  *cached' <<<"$harness"; then
  echo "1 prep      done     lab keys generated, image cached"
else
  echo "1 prep      todo     run: mise run prep"
  next="prep"
fi

vm_state="$(awk '$1 == "vm" {print $2}' <<<"$harness")"
case "$vm_state" in
  running)
    echo "2 vm        running  $(sed -n 's/^vm  *running  *//p' <<<"$harness")"
    ;;
  stopped)
    echo "2 vm        stopped  run: mise run vm:start"
    next="${next:-vm:start}"
    ;;
  *)
    echo "2 vm        absent   run: mise run vm:build (or up for the whole thread)"
    next="${next:-up}"
    ;;
esac

echo "3 converge  ?        converge is the check: changed=0 means conformant"
echo
echo "next: mise run ${next:-host:converge}"
