#!/usr/bin/env bash
#MISE description="Stages done so far, and the next command"
#MISE quiet=true
set -euo pipefail
. "$MISE_CONFIG_ROOT/mise-tasks/lib.sh"
next=""

if [ -s "$QEMU_KEYS_DIR/ubuntu-ansible.pub" ] && [ -s "$QEMU_KEYS_DIR/ubuntu-sysadmin.pub" ] \
  && qvm status | grep -q '^image  *cached'; then
  echo "1 prep      done     lab keys generated, image cached"
else
  echo "1 prep      todo     run: mise run prep"
  next="prep"
fi

if [ -f "$QVM_DIR/qemu.pid" ] && kill -0 "$(cat "$QVM_DIR/qemu.pid")" 2>/dev/null; then
  echo "2 vm        running  pid $(cat "$QVM_DIR/qemu.pid"), ssh 127.0.0.1:$QVM_SSH_PORT"
elif [ -d "$QVM_DIR" ]; then
  echo "2 vm        stopped  run: mise run vm:start"
  next="${next:-vm:start}"
else
  echo "2 vm        absent   run: mise run vm:build (or up for the whole thread)"
  next="${next:-up}"
fi

echo "3 converge  ?        converge is the check: changed=0 means conformant"
echo
echo "next: mise run ${next:-host:converge}"
