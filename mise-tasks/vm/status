#!/usr/bin/env bash
#MISE description="Stages done so far, and the next command"
#MISE quiet=true
set -euo pipefail
next=""

# One harness status call answers both rows; its vocabulary is contract
# (cur8s/qemu RFC-001): image cached|missing, vm running|stopped|absent.
# Every detail cell is a concrete fact or a typeable command — this
# display reports, it never teaches.
harness="$(bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" status)"

# Keys are not a stage: vm:build-provisioned generates them on demand.
if grep -q '^image  *cached' <<<"$harness"; then
  echo "1 image     cached   in .generated/qemu/cache"
else
  echo "1 image     missing  up fetches on demand (pre-warm: mise run vm:fetch-image)"
fi

vm_state="$(awk '$1 == "vm" {print $2}' <<<"$harness")"
case "$vm_state" in
  running)
    echo "2 vm        running  ssh 127.0.0.1:$QVM_SSH_PORT — mise run ssh:ansible for a shell"
    ;;
  stopped)
    echo "2 vm        stopped  run: mise run vm:start"
    next="${next:-vm:start}"
    ;;
  *)
    echo "2 vm        absent   run: mise run vm:build-provisioned (or up for the whole thread)"
    next="${next:-up}"
    ;;
esac

echo
echo "next: mise run ${next:-host:converge}"
