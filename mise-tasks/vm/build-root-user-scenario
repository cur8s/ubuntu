#!/usr/bin/env bash
#MISE description="Build the root-entry scenario: a rehearsal server where root can SSH straight in (next: vm:start)"
#MISE quiet=true
set -euo pipefail
. "$MISE_CONFIG_ROOT/collection/scripts/activate-test-credentials.sh"
activate_test_credentials
echo "Creating the root-user scenario VM (door on: root)"
if [ -e "$QVM_DIR" ]; then
  echo "A local QEMU VM already exists at $QVM_DIR (mise run vm:destroy first)." >&2
  exit 1
fi
# The seed models the DigitalOcean shape: the provider injects the
# bootstrap key into root and creates no other account. Entering as root
# involves no sudo chain anywhere — the code path no other rehearsal
# covers — and locking root afterwards closes the one door that can
# never be deleted. The users list naming only root keeps cloud-init
# from creating the image's default user.
user_data="$MISE_CONFIG_ROOT/.generated/cloud-init/scenario-root-user.yaml"
mkdir -p "$(dirname "$user_data")"
{
  printf '#cloud-config\n'
  printf 'disable_root: false\n'
  printf 'ssh_pwauth: false\n'
  printf 'users:\n'
  printf '  - name: root\n'
  printf '    ssh_authorized_keys:\n'
  printf '      - "%s"\n' "$(cat "$BOOTSTRAP_PUB_KEY")"
} > "$user_data"
QVM_NAME="ubuntu-qemu-root-user" QVM_USER_DATA="$user_data" \
  bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" build-vm

echo "root-user scenario VM prepared in $QVM_DIR (no baseline accounts, no dist-upgrade, no reboot)."
echo "Next: mise run vm:start, then ADOPT_USER=root mise run host:adoptable"
