#!/usr/bin/env sh
#MISE description="Scenario: a pre-baseline server whose door is a sudo user (SCENARIO_USER, default ubuntu) — next: vm:boot, then host:adoptable"
#MISE quiet=true
#MISE depends=["fetch"]
set -eu
. "$MISE_CONFIG_ROOT/mise-tasks/lib.sh"
qemu_keys_env
scenario_user="${SCENARIO_USER:-ubuntu}"
echo "Creating the sudo-user scenario VM (door on: $scenario_user)"
if [ -e "$QEMU_VM_DIR" ]; then
  echo "A local QEMU VM already exists at $QEMU_VM_DIR (mise run vm:destroy first)." >&2
  exit 1
fi
# The seed deliberately does NOT use the baseline render: this VM models
# an existing server that predates the baseline — the AWS/installer shape
# with the default name, the Azure shape with SCENARIO_USER=azureuser
# (nothing in the collection may care which; that is the point). One
# sudo-capable user reachable by the bootstrap key — the pre-baseline
# door adoption connects through (ADOPT_USER) — and password auth left
# on, so the adoptability warning has something real to find.
user_data="$MISE_CONFIG_ROOT/.generated/cloud-init/scenario-sudo-user.yaml"
mkdir -p "$(dirname "$user_data")"
{
  printf '#cloud-config\n'
  printf 'ssh_pwauth: true\n'
  printf 'users:\n'
  printf '  - name: %s\n' "$scenario_user"
  printf '    shell: /bin/bash\n'
  printf '    groups: [sudo]\n'
  printf '    sudo: "ALL=(ALL) NOPASSWD:ALL"\n'
  printf '    lock_passwd: true\n'
  printf '    ssh_authorized_keys:\n'
  printf '      - "%s"\n' "$(cat "$BOOTSTRAP_PUB_KEY")"
} > "$user_data"
QVM_NAME="ubuntu-qemu-sudo-user" QVM_USER_DATA="$user_data" qvm create

echo "sudo-user scenario VM prepared in $QEMU_VM_DIR (no baseline accounts, no dist-upgrade, no reboot)."
echo "Next: mise run vm:boot, then mise run host:adoptable"
