#!/usr/bin/env bash
#MISE description="Print the boot log and follow it — the debug window when SSH is down"
set -euo pipefail
if [ ! -f "$QVM_DIR/console.log" ]; then
  echo "No console log yet (mise run up builds and starts the VM)." >&2
  exit 1
fi
# Delegate to the vendored verb: the whole log from line 1, then follow.
bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" show-boot-log
