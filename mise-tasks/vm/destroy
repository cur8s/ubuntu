#!/usr/bin/env sh
#MISE description="Kills the VM and deletes its state; the image cache survives"
#MISE confirm="Destroy the local QEMU VM and delete its state directory? This cannot be undone."
set -eu
if [ ! -e "$QEMU_VM_DIR" ]; then
  echo "No local QEMU VM to destroy."
  exit 0
fi

if [ -f "$QEMU_VM_DIR/qemu.pid" ] && kill -0 "$(cat "$QEMU_VM_DIR/qemu.pid")" 2>/dev/null; then
  pid="$(cat "$QEMU_VM_DIR/qemu.pid")"
  kill "$pid"
  # Do not remove the disk under a live process.
  waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge 30 ]; then
      echo "QEMU (pid $pid) did not exit after SIGTERM; refusing to delete its state." >&2
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
fi

rm -rf "$QEMU_VM_DIR"
echo "Local QEMU VM destroyed (cached image kept in $QEMU_CACHE_DIR)."
