#!/usr/bin/env bash
#MISE description="Assemble the VM on disk; nothing starts (next: vm:start)"
#MISE quiet=true
set -euo pipefail
. "$MISE_CONFIG_ROOT/collection/scripts/activate-test-credentials.sh"
echo "Creating the local QEMU Ubuntu test VM"

# Render with the lab's throwaway keys (RFC-004: ephemeral test credentials)
# into the lab's own output file; the VM mechanics live in the vendored
# mise-tasks/vendor/qemu-vm.sh.
activate_test_credentials
export CLOUD_INIT_FILE="$QEMU_CLOUD_INIT_FILE"
# Collection scripts ship without exec bits, so callers name the
# interpreter their shebang names — uniformly bash.
bash "$MISE_CONFIG_ROOT/collection/scripts/render-cloud-init.sh"

QVM_USER_DATA="$QEMU_CLOUD_INIT_FILE" \
  bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" build-vm
echo "VM built in $QVM_DIR. Next: mise run vm:start"
