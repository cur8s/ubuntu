#!/usr/bin/env sh
#MISE description="Overlay disk + NoCloud seed from rendered cloud-init (next: vm:boot)"
#MISE quiet=true
set -eu
. "$MISE_CONFIG_ROOT/mise-tasks/lib.sh"
echo "Creating the local QEMU Ubuntu test VM"

# Render with the lab's throwaway keys (RFC-004: ephemeral lab credentials)
# into the lab's own output file; the VM mechanics live in the vendorable
# scripts/qemu-vm.sh.
qemu_keys_env
sh "$MISE_CONFIG_ROOT/collection/scripts/render-cloud-init.sh"

QVM_USER_DATA="$QEMU_CLOUD_INIT_FILE" qvm create
echo "Next: mise run vm:boot"
