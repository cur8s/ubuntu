#!/usr/bin/env bash
#MISE description="Build a server to practice adoption on: root-user (root SSHes straight in) or sudo-user (you enter as a sudo user) (next: vm:start)"
#MISE quiet=true
set -euo pipefail
. "$MISE_CONFIG_ROOT/collection/scripts/activate-test-credentials.sh"

shape="${1:-}"
if [[ $shape != root-user && $shape != sudo-user ]]; then
  echo "usage: mise run vm:build-adoptable <root-user|sudo-user>" >&2
  exit 1
fi
if [ -e "$QVM_DIR" ]; then
  echo "A local QEMU VM already exists at $QVM_DIR (mise run vm:destroy first)." >&2
  exit 1
fi
activate_test_credentials

# A rehearsal server models an existing server that predates the baseline, so
# its seed deliberately does NOT use the baseline render. The seed embeds
# the bootstrap key, so each build renders the one seed it boots, fresh.
# The heredocs expand $-substitutions; escape any literal $ in a seed.
user_data="$MISE_CONFIG_ROOT/.generated/cloud-init/rehearsal-$shape.yaml"
mkdir -p "$(dirname "$user_data")"
case "$shape" in
  root-user)
    echo "Creating the root-user rehearsal server (door on: root)"
    # The DigitalOcean shape: the provider injects the bootstrap key into
    # root and creates no other account. Entering as root involves no
    # sudo chain anywhere — the code path no other rehearsal covers — and
    # locking root afterwards closes the one door that can never be
    # deleted. The users list naming only root keeps cloud-init from
    # creating the image's default user.
    cat > "$user_data" <<EOF
#cloud-config
disable_root: false
ssh_pwauth: false
users:
  - name: root
    ssh_authorized_keys:
      - "$(cat "$BOOTSTRAP_PUB_KEY")"
EOF
    next_hint="ADOPT_USER=root mise run host:adoptable"
    ;;
  sudo-user)
    door_user="${DOOR_USER:-ubuntu}"
    echo "Creating the sudo-user rehearsal server (door on: $door_user)"
    # The AWS/installer shape with the default name, the Azure shape with
    # DOOR_USER=azureuser (nothing in the collection may care which;
    # that is the point). One sudo-capable user reachable by the
    # bootstrap key — the pre-baseline door adoption connects through
    # (ADOPT_USER) — and password auth left on, so the adoptability
    # warning has something real to find.
    cat > "$user_data" <<EOF
#cloud-config
ssh_pwauth: true
users:
  - name: $door_user
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - "$(cat "$BOOTSTRAP_PUB_KEY")"
EOF
    next_hint="mise run host:adoptable"
    ;;
esac

QVM_NAME="ubuntu-qemu-$shape" QVM_USER_DATA="$user_data" \
  bash "$MISE_CONFIG_ROOT/mise-tasks/vendor/qemu-vm.sh" build-vm

echo "$shape rehearsal server prepared in $QVM_DIR (no baseline accounts, no dist-upgrade, no reboot)."
echo "Next: mise run vm:start, then $next_hint"
