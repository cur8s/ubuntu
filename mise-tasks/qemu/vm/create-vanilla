#!/usr/bin/env sh
#MISE description="A stock Ubuntu VM with one installer-style user — the adoption specimen (next: qemu:vm:boot, then qemu:play:adoptable)"
#MISE quiet=true
#MISE depends=["key:prep", "qemu:fetch"]
set -eu
echo "Creating the vanilla (pre-baseline) QEMU VM"
if [ -e "$QEMU_VM_DIR" ]; then
  echo "A local QEMU VM already exists at $QEMU_VM_DIR (mise run qemu:vm:destroy first)." >&2
  exit 1
fi
mkdir -p "$QEMU_VM_DIR"

# Copy-on-write overlay, exactly as qemu:vm:create.
base_image="$QEMU_CACHE_DIR/$(basename "$QEMU_IMAGE_URL")"
qemu-img create -q -f qcow2 -b "$base_image" -F qcow2 \
  "$QEMU_VM_DIR/disk.qcow2" "$QEMU_DISK_SIZE"

# The seed deliberately does NOT use the baseline render: this VM models an
# existing server that predates the baseline. One installer-style user
# (ubuntu, sudo-capable), reachable by the bootstrap key — the pre-baseline
# door adoption connects through (ADOPT_USER=ubuntu) — and password auth
# left on, so the adoptability warning has something real to find.
seed_dir="$QEMU_VM_DIR/seed"
mkdir -p "$seed_dir"
{
  printf '#cloud-config\n'
  printf 'ssh_pwauth: true\n'
  printf 'users:\n'
  printf '  - name: ubuntu\n'
  printf '    shell: /bin/bash\n'
  printf '    groups: [sudo]\n'
  printf '    sudo: "ALL=(ALL) NOPASSWD:ALL"\n'
  printf '    lock_passwd: true\n'
  printf '    ssh_authorized_keys:\n'
  printf '      - "%s"\n' "$(cat "$BOOTSTRAP_PUB_KEY")"
} > "$seed_dir/user-data"
printf 'instance-id: %s\nlocal-hostname: %s\n' "ubuntu-qemu-vanilla" "ubuntu-qemu-vanilla" \
  > "$seed_dir/meta-data"
hdiutil makehybrid -quiet -iso -joliet -default-volume-name cidata \
  -o "$QEMU_VM_DIR/seed.iso" "$seed_dir"

cp "$(brew --prefix qemu)/share/qemu/edk2-arm-vars.fd" "$QEMU_VM_DIR/efivars.fd"

echo "Vanilla VM prepared in $QEMU_VM_DIR (no baseline accounts, no dist-upgrade, no reboot)."
echo "Next: mise run qemu:vm:boot, then mise run qemu:play:adoptable"
