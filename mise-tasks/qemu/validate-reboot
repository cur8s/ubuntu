#!/usr/bin/env sh
#MISE description="Acceptance test: reboot the local QEMU VM, re-verify baseline access and services"
set -eu
. "$MISE_CONFIG_ROOT/mise-tasks/lib.sh"
ssh_task_preamble

ANSIBLE_SSH_COMMON_ARGS="-o UserKnownHostsFile=$QEMU_VM_DIR/known_hosts -o StrictHostKeyChecking=accept-new" \
ansible-playbook \
  -i "$(qemu_inventory)" \
  "$MISE_CONFIG_ROOT/collection/playbooks/validate_reboot.yml"
