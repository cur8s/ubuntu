#!/usr/bin/env sh
#MISE description="Show the local QEMU lab state (running, pid, SSH port)"
#MISE quiet=true
set -eu
if [ -f "$QEMU_VM_DIR/qemu.pid" ] && kill -0 "$(cat "$QEMU_VM_DIR/qemu.pid")" 2>/dev/null; then
  echo "running  pid $(cat "$QEMU_VM_DIR/qemu.pid")  ssh 127.0.0.1:$QEMU_SSH_PORT"
elif [ -d "$QEMU_VM_DIR" ]; then
  echo "stopped  (state in $QEMU_VM_DIR; start with: mise run qemu:boot)"
else
  echo "absent   (create with: mise run qemu:up)"
fi

if [ -f "$QEMU_CACHE_DIR/$(basename "$QEMU_IMAGE_URL")" ]; then
  echo "image cache: present"
else
  echo "image cache: absent (fetched by: mise run qemu:prep)"
fi
