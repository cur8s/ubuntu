#!/usr/bin/env sh
#MISE description="Fetch and checksum-verify the Ubuntu 24.04 arm64 cloud image (no-op if cached)"
#MISE hide=true
set -eu
image_name="$(basename "$QEMU_IMAGE_URL")"
image="$QEMU_CACHE_DIR/$image_name"

if [ -f "$image" ]; then
  echo "Using cached image $image"
  exit 0
fi

mkdir -p "$QEMU_CACHE_DIR"
echo "Fetching $QEMU_IMAGE_URL"
curl -fL --progress-bar -o "$image.partial" "$QEMU_IMAGE_URL"

expected="$(curl -fsSL "$QEMU_SHA256SUMS_URL" | awk -v f="*$image_name" '$2 == f {print $1}')"
if [ -z "$expected" ]; then
  echo "$image_name not found in $QEMU_SHA256SUMS_URL" >&2
  exit 1
fi
actual="$(shasum -a 256 "$image.partial" | awk '{print $1}')"
if [ "$expected" != "$actual" ]; then
  echo "Checksum mismatch for $image_name: expected $expected, got $actual" >&2
  exit 1
fi

mv "$image.partial" "$image"
echo "Fetched and verified $image"
