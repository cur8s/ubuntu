#!/usr/bin/env sh
#MISE description="Show this workflow cheat sheet (runs on bare 'mise run')"
#MISE quiet=true
set -eu

# Bold headers, cyan task names, dim annotations — only on a terminal, and
# honoring the NO_COLOR convention (https://no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B="$(printf '\033[1m')"
  D="$(printf '\033[2m')"
  C="$(printf '\033[36m')"
  R="$(printf '\033[0m')"
else
  B=""; D=""; C=""; R=""
fi

cat <<EOF
${B}cur8s.ubuntu labs${R} ${D}— full details: docs/operations/manual.md${R}

${B}GRAMMAR${R}: every task is   ${D}mise run${R} ${C}<provider>:<object>:<action>${R}

  ${B}providers${R}
    ${C}qemu${R}    local QEMU VM ${D}(free, arm64)${R}
    ${C}do${R}      DigitalOcean droplet ${D}(amd64)${R}

  ${B}objects${R}
    ${C}vm${R}      the machine itself       ${D}create, boot, wait, status, destroy, ...${R}
    ${C}play${R}    a collection playbook    ${D}converge, update, validate-reboot, ...${R}
    ${C}ssh${R}     a shell, as this user    ${D}ansible, sysadmin, root${R}
    ${C}test${R}    an example, or all       ${D}docker, k3s, zot, ..., all${R}

  ${B}workflows${R} ${D}(no object — the provider itself is the object)${R}
    ${C}prep${R}    one-time groundwork
    ${C}up${R}      provision + converge

  Same grammar on every provider: swap ${C}qemu:${R} for ${C}do:${R} and it just works.

${B}A SESSION, START TO FINISH${R} ${D}(local provider shown)${R}

  ${D}mise run${R} ${C}qemu:prep${R}             once: 1Password keys + cloud image cache ${D}(~600MB)${R}
  ${D}mise run${R} ${C}qemu:up${R}               stand up the lab, unattended
                                 ${D}(= vm:create -> vm:boot -> vm:wait -> play:converge)${R}
  ${D}mise run${R} ${C}qemu:vm:status${R}        where am I? stages done, and the next command
  ${D}mise run${R} ${C}qemu:ssh:ansible${R}      inspect by hand ${D}(boot problems: qemu:vm:console)${R}
  ${D}mise run${R} ${C}qemu:play:converge${R}    daily re-assert; changed=0 means conformant
  ${D}mise run${R} ${C}qemu:test:docker${R}      test one example: runs it twice,
                                 second pass must report changed=0
  ${D}mise run${R} ${C}qemu:test:all${R}         every example, same contract
  ${D}mise run${R} ${C}qemu:play:validate-reboot${R}   acceptance gate: reboot, re-verify access
  ${D}mise run${R} ${C}qemu:vm:destroy${R}       tear down; the cached image survives

  ${B}Droplet extras${R}: ${C}do:ssh:root${R} is the provider bootstrap door — until
  ${C}do:play:retire-bootstrap${R} locks it ${D}(run the acceptance gate first)${R}.

  ${C}clean${R}  destroy both labs + wipe .generated        ${C}mise tasks${R}  the full list
EOF
