#!/usr/bin/env bash
#MISE description="The workflow cheat sheet (what bare 'mise run' prints)"
#MISE quiet=true
set -euo pipefail

# Bold headers, cyan task names, dim annotations — only on a terminal, and
# honoring the NO_COLOR convention (https://no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B="$(printf '\033[1m')"
  D="$(printf '\033[2m')"
  C="$(printf '\033[36m')"
  R="$(printf '\033[0m')"
else
  B=""; D=""; C=""; R=""
fi

cat <<EOF
${B}cur8s.ubuntu harness${R} ${D}— full details: docs/guides/developer-guide.md${R}

${B}GRAMMAR${R}   ${D}mise run${R} ${C}<object>:<action>${R} ${D}— everything here acts on the local
          QEMU lab (free, host-arch; CI runs it on amd64); cloud harnesses
          live with the operator's cloud custody, same grammar inside${R}

  ${B}objects${R}
    ${C}vm${R}      the machine itself       ${D}build-provisioned, build-adoptable, build-unadoptable, start, status, destroy, ...${R}
    ${C}host${R}    the managed system       ${D}converge, adopt, reboot-and-verify, ...${R}
    ${C}ssh${R}     a shell, as this user    ${D}ansible, sysadmin${R}
    ${C}test${R}    an example, or a suite   ${D}docker, zot, tailscale, all;
                                     adoption, adoption-refusals, adoption-verdicts,
                                     rotation, render, patch, lock-refusals, reboot-refusal${R}

  ${B}workflows${R} ${D}(no object — the lab itself is the object)${R}
    ${C}up${R}      provision + converge ${D}(fetches keys and image on demand)${R}
    ${C}clean${R}   destroy the lab VM and wipe .generated ${D}(recover: mise run up)${R}

${B}A SESSION, START TO FINISH${R}

  ${D}mise run${R} ${C}vm:fetch-image${R}         optional pre-warm: the ~600MB image ${D}(up fetches on demand)${R}
  ${D}mise run${R} ${C}up${R}                     stand up the lab, unattended
                                ${D}(= vm:build-provisioned -> vm:start -> vm:wait-until-ready -> host:converge)${R}
  ${D}mise run${R} ${C}vm:status${R}              where am I? stages done, which VM, the next command
  ${D}mise run${R} ${C}ssh:ansible${R}            inspect by hand ${D}(boot problems: vm:show-boot-log)${R}
  ${D}mise run${R} ${C}host:report-drift${R}      is anything drifting? read-only, like report-access
  ${D}mise run${R} ${C}host:converge${R}          daily enforcement; changed=0 means conformant
  ${D}mise run${R} ${C}test:docker${R}            test one example: runs it twice,
                                second pass must report changed=0
  ${D}mise run${R} ${C}test:all${R}               every example, same contract
  ${D}mise run${R} ${C}host:reboot-and-verify${R}   acceptance gate: reboot, re-verify access
  ${D}mise run${R} ${C}vm:destroy${R}             tear down; the cached image survives

  ${B}Real providers${R}: the release gate is the consumer-shaped DigitalOcean
  harness in the operator's sandbox repo ${D}(developed here; history at b0ba5ff)${R}.

  ${D}The full task list:${R} ${C}mise tasks${R}
EOF
