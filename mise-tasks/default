#!/usr/bin/env sh
#MISE description="Show the workflow cheat sheet (what bare 'mise run' prints)"
#MISE quiet=true
set -eu

# Bold headers, cyan task names, dim annotations — only on a terminal, and
# honoring the NO_COLOR convention (https://no-color.org).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B="$(printf '\033[1m')"
  D="$(printf '\033[2m')"
  C="$(printf '\033[36m')"
  R="$(printf '\033[0m')"
else
  B=""; D=""; C=""; R=""
fi

cat <<EOF
${B}cur8s.ubuntu harness${R} ${D}— full details: docs/guides/developer-guide.md${R}

${B}GRAMMAR${R}   ${D}mise run${R} ${C}<provider>:<object>:<action>${R}

  ${B}providers${R}
    ${C}qemu${R}    local QEMU VM ${D}(free, arm64 — the everyday lab)${R}
    ${D}(cloud harnesses live with the operator's cloud custody — same grammar inside)${R}

  ${B}objects${R}
    ${C}vm${R}      the machine itself       ${D}create, boot, wait, status, destroy, ...${R}
    ${C}host${R}    the managed system       ${D}converge, adopt, validate-reboot, ...${R}
    ${C}ssh${R}     a shell, as this user    ${D}ansible, sysadmin${R}
    ${C}test${R}    an example, or a suite   ${D}docker, ..., all; scenarios (adoption rehearsals)${R}

  ${B}workflows${R} ${D}(no object — the provider itself is the object)${R}
    ${C}prep${R}    one-time groundwork
    ${C}up${R}      provision + converge

  ${B}workstation${R} ${D}(no provider — acts on this repo checkout)${R}
    ${C}clean${R}   destroy the local lab VM and wipe .generated ${D}(recover: re-run prep)${R}

${B}A SESSION, START TO FINISH${R} ${D}(local provider shown)${R}

  ${D}mise run${R} ${C}qemu:prep${R}             once: throwaway lab keys + cloud image cache ${D}(~600MB)${R}
  ${D}mise run${R} ${C}qemu:up${R}               stand up the lab, unattended
                                 ${D}(= vm:create -> vm:boot -> vm:wait -> host:converge)${R}
  ${D}mise run${R} ${C}qemu:vm:status${R}        where am I? stages done, and the next command
  ${D}mise run${R} ${C}qemu:ssh:ansible${R}      inspect by hand ${D}(boot problems: qemu:vm:console)${R}
  ${D}mise run${R} ${C}qemu:host:check${R}       drift alarm: the converge report, nothing enforced
  ${D}mise run${R} ${C}qemu:host:converge${R}    daily enforcement; changed=0 means conformant
  ${D}mise run${R} ${C}qemu:test:docker${R}      test one example: runs it twice,
                                 second pass must report changed=0
  ${D}mise run${R} ${C}qemu:test:all${R}         every example, same contract
  ${D}mise run${R} ${C}qemu:host:validate-reboot${R}   acceptance gate: reboot, re-verify access
  ${D}mise run${R} ${C}qemu:vm:destroy${R}       tear down; the cached image survives

  ${B}Real providers${R}: the release gate is the consumer-shaped DigitalOcean
  harness in the operator's sandbox repo ${D}(developed here; history at b0ba5ff)${R}.

  ${D}The full task list:${R} ${C}mise tasks${R}
EOF
