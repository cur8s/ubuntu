#!/usr/bin/env sh
#MISE description="Show this workflow cheat sheet (runs on bare 'mise run')"
#MISE quiet=true
set -eu
cat <<'EOF'
cur8s.ubuntu labs — full details: docs/operations/manual.md

  stage                     local QEMU (free, arm64)      droplet (amd64)
  ------------------------  ----------------------------  ---------------------
  1. prep (once)            qemu:prep                     do:prep
  2. provision a VM         qemu:vm:create                do:vm:create
                              -> qemu:vm:boot               -> do:vm:wait
                              -> qemu:vm:wait
  3. inspect by hand        qemu:ssh:ansible              do:ssh:ansible
       where am I?          qemu:vm:status                do:vm:status
       debug console        qemu:vm:console               —
  4. converge (daily)       qemu:converge                 do:converge
  5. test the examples      qemu:examples                 do:examples
  6. acceptance gate        qemu:validate-reboot          do:validate-reboot
  7. tear down              qemu:vm:destroy               do:vm:destroy

  Stages 2+4 in one shot:   qemu:up                       do:up
  One example:              qemu:example <name>           do:example <name>
  Start over completely:    clean          Every task:    mise tasks

Run any of these as: mise run <task>
EOF
