#!/usr/bin/env sh
#MISE description="Show the droplet lab state: stages done so far and the next step"
#MISE quiet=true
set -eu
next=""

bootstrap_key_id="$(doctl compute ssh-key list --output json | jq -r --arg name "$DO_BOOTSTRAP_KEY_NAME" '.[] | select(.name == $name) | .id')"
if [ -s "$ANSIBLE_PUB_KEY" ] && [ -s "$SYSADMIN_PUB_KEY" ] && [ -n "$bootstrap_key_id" ]; then
  echo "1 prep      done     keys extracted, bootstrap key registered (ID $bootstrap_key_id)"
else
  echo "1 prep      todo     run: mise run do:prep"
  next="do:prep"
fi

droplet_line="$(doctl compute droplet list "$DROPLET_NAME" --format Name,PublicIPv4,Status --no-header)"
if [ -n "$droplet_line" ]; then
  echo "2 vm        $droplet_line"
else
  echo "2 vm        absent   run: mise run do:vm:create (or do:up for the whole thread)"
  next="${next:-do:up}"
fi

echo "3 converge  ?        converge is the check: changed=0 means conformant"
echo
echo "next: mise run ${next:-do:converge}"
