#!/usr/bin/env sh
#MISE description="Register the bootstrap SSH public key with DigitalOcean (no-op if already registered)"
#MISE depends=["key:prep"]
set -eu
existing_id="$(doctl compute ssh-key list --output json | jq -r --arg name "$DO_BOOTSTRAP_KEY_NAME" '.[] | select(.name == $name) | .id')"
if [ -n "$existing_id" ]; then
  echo "Bootstrap key '$DO_BOOTSTRAP_KEY_NAME' is already registered with DigitalOcean (ID $existing_id)."
  echo "Rotating it is a deliberate act: mise run do:key-delete, then rerun this task."
  exit 0
fi

doctl compute ssh-key import "$DO_BOOTSTRAP_KEY_NAME" \
  --public-key-file "$BOOTSTRAP_PUB_KEY" \
  --format ID,Name
