#!/usr/bin/env sh
#MISE description="Create the DigitalOcean Ubuntu test VM (next: do:wait — or just do:up)"
#MISE quiet=true
#MISE depends=["cloud-init:render"]
#MISE hide=true
set -eu
echo "Creating the DigitalOcean Ubuntu test VM"
droplet_count="$(doctl compute droplet list "$DROPLET_NAME" --output json | jq length)"
bootstrap_key_id="$(doctl compute ssh-key list --output json | jq -r --arg name "$DO_BOOTSTRAP_KEY_NAME" '.[] | select(.name == $name) | .id')"

if [ "$droplet_count" -ne 0 ]; then
  echo "A DigitalOcean Droplet named $DROPLET_NAME already exists." >&2
  exit 1
fi

doctl compute droplet create "$DROPLET_NAME" \
  --image ubuntu-24-04-x64 \
  --size s-1vcpu-1gb \
  --region tor1 \
  --ssh-keys "$bootstrap_key_id" \
  --user-data-file "$CLOUD_INIT_FILE" \
  --format ID,Name,PublicIPv4,Status,Image \
  --wait
