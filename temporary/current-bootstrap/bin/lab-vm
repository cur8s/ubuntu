#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
export UBUNTU_BOOTSTRAP_ROOT="$ROOT_DIR"

# shellcheck source=../lib/common.sh
source "$ROOT_DIR/lib/common.sh"
# shellcheck source=../lab/lib/doctl.sh
source "$ROOT_DIR/lab/lib/doctl.sh"

usage() {
  cat <<'USAGE'
Usage: ./bin/lab-vm <command> [options]

Commands:
  init                  Create .state/digitalocean.env from the example.
  init-key              Generate/import the configured SSH key.
  create                Create the DigitalOcean lab Droplet.
  status                Show the current lab Droplet.
  ssh [-- command]      SSH to the lab Droplet, optionally running a command.
  sync                  Copy this repo to the lab Droplet.
  bootstrap             Sync, then run ubuntu-bootstrap on the lab Droplet.
  check                 Run ubuntu-check on the lab Droplet.
  destroy --force       Destroy the lab Droplet.

Common options:
  -h, --help            Show this help.

Local configuration lives in .state/digitalocean.env and is not committed.
USAGE
}

command_name="${1:-}"
if [ -z "$command_name" ]; then
  usage
  exit 1
fi
if [ "$command_name" = "-h" ] || [ "$command_name" = "--help" ]; then
  usage
  exit 0
fi
shift

force="0"
ssh_args=()
remote_dir_quoted=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force)
      force="1"
      shift
      ;;
    --)
      shift
      ssh_args=("$@")
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      ssh_args+=("$1")
      shift
      ;;
  esac
done

case "$command_name" in
  init)
    lab_init_config
    ;;
  init-key)
    load_lab_config
    require_doctl
    require_doctl_auth
    lab_generate_ssh_key
    lab_ensure_do_ssh_key
    ;;
  create)
    load_lab_config
    require_doctl
    require_doctl_auth
    lab_ensure_local_ssh_key
    lab_create_droplet
    lab_wait_for_ssh
    ;;
  status)
    load_lab_config
    require_doctl
    require_doctl_auth
    lab_status
    ;;
  ssh)
    load_lab_config
    lab_ssh "${ssh_args[@]}"
    ;;
  sync)
    load_lab_config
    lab_sync_repo
    ;;
  bootstrap)
    load_lab_config
    lab_sync_repo
    remote_dir_quoted="$(printf '%q' "$DO_REMOTE_DIR")"
    lab_remote "cd $remote_dir_quoted && sudo ./bin/ubuntu-bootstrap"
    ;;
  check)
    load_lab_config
    remote_dir_quoted="$(printf '%q' "$DO_REMOTE_DIR")"
    lab_remote "cd $remote_dir_quoted && sudo ./bin/ubuntu-check"
    ;;
  destroy)
    load_lab_config
    require_doctl
    require_doctl_auth
    if [ "$force" != "1" ]; then
      die "destroy requires --force"
    fi
    lab_destroy_droplet
    ;;
  *)
    usage
    die "unknown command: $command_name"
    ;;
esac
