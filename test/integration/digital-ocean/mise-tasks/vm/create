#!/usr/bin/env sh
#MISE description="Renders cloud-init first (next: vm:wait — or just up)"
#MISE quiet=true
#MISE depends=["cloud-init:render"]
set -eu
echo "Creating droplet $DROPLET_NAME"
droplet_count="$(doctl compute droplet list "$DROPLET_NAME" --output json | jq length)"
bootstrap_key_id="$(doctl compute ssh-key list --output json | jq -r --arg name "$DO_BOOTSTRAP_KEY_NAME" '.[] | select(.name == $name) | .id')"

if [ "$droplet_count" -ne 0 ]; then
  echo "A droplet named $DROPLET_NAME already exists." >&2
  exit 1
fi
if [ -z "$bootstrap_key_id" ]; then
  echo "Bootstrap key '$DO_BOOTSTRAP_KEY_NAME' is not registered with DigitalOcean (run: mise run prep)." >&2
  exit 1
fi

doctl compute droplet create "$DROPLET_NAME" \
  --image "$DROPLET_IMAGE" \
  --size "$DROPLET_SIZE" \
  --region "$DROPLET_REGION" \
  --ssh-keys "$bootstrap_key_id" \
  --user-data-file "$CLOUD_INIT_FILE" \
  --format ID,Name,PublicIPv4,Status,Image \
  --wait
